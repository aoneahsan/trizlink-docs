{
  "name": "trizlink-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Public documentation for Trizlink, built with Docusaurus and deployed to GitHub Pages.",
  "author": {
    "name": "Ahsan Mahmood",
    "email": "aoneahsan@gmail.com",
    "url": "https://aoneahsan.com"
  },
  "license": "MIT",
  "homepage": "https://trizlink.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aoneahsan/trizlink-docs.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start --port 5962 --host 0.0.0.0",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve --port 5963",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc --noEmit",
    "og:png": "rsvg-convert -w 1200 -h 630 static/img/social-card.svg -o static/img/social-card.png"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/theme-mermaid": "^3.10.2",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "typescript": "~6.0.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "packageManager": "yarn@4.18.1"
}
